# Claude /plan-w-team test corpus + per-run state (synced/vendored — not tracked in consumers)
tests/skill/cases/
tests/skill/scenarios/
.claude/scripts/*.test.sh
.claude/scripts/*.test.ts
.claude/hooks/*.test.sh
.claude/state/plan-w-team-credwall-*.json
.claude/state/pwt-brief-*.md
.claude/state/plan-w-team-ship-verdict-*
.claude/state/supervisor-progress-*.json

# Claude per-run state default-deny (sync-managed; tracked paths negated below)
.claude/state/*
